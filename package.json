{
	"name": "pi-subagent",
	"version": "0.1.0",
	"private": true,
	"description": "Observable, persistent Pi subagents",
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"bin": {
		"subagent": "./subagent.ts"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"piDurable": {
		"extensions": [
			"./durable.ts"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "biome check . && tsc -p tsconfig.json && vitest --run --passWithNoTests",
		"test": "vitest --run --passWithNoTests"
	},
	"dependencies": {
		"@earendil-works/chord": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0"
	},
	"optionalDependencies": {
		"@earendil-works/pi-ai": "^1.3.0",
		"@earendil-works/pi-coding-agent": "^1.3.0",
		"@earendil-works/pi-tui": "^1.3.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "26.6.4",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	}
}
